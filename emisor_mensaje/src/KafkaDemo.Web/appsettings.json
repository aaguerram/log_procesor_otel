{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "KafkaDemo": "Information"
    }
  },
  "AllowedHosts": "*",
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ClientId": "KafkaDemo-WebAdmin",
    "TargetTopic": "tp.observability.application-log.emitted.v1",
    "Acks": "all",
    "EnableIdempotence": true
  },
  "KeyVault": {
    "VaultUri": "https://azure-keyvault:8443",
    "VaultName": "produbanco-local-vault"
  }
}
